__pycache__/
*.pyc
*.pyo
*.pyd
*.mo
*.egg-info

# Virtual environments
env/
venv/
.venv/

# OS-specific files
.DS_Store
Thumbs.db

# Git and version control
.git
.gitignore

# IDE / editor settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

